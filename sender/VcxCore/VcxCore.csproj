<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared sender code: protocol, capture, stream logic, config, reconnect logic. Used by vcx-sender (console) and vcx-tray. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>VcxCore</AssemblyName>
    <RootNamespace>Vcx.Sender</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="sender.Tests" />
  </ItemGroup>

</Project>
